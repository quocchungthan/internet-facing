# Settings for running LingoBridge (Streams/SchoolBoard) through School/RunAsWindowService.ps1 on the host.
# The API reads ASP.NET Core configuration; RunAsWindowService.ps1 reads the first four keys from
# `dotnet user-secrets` of Translation.Api (set them with: dotnet user-secrets set "<Key>" "<value>" --project <api>).
# They are listed here in environment-variable form (":" becomes "__"). Never commit real values.

# --- Required (script aborts if any is missing) ---
ConnectionStrings__Default=Host=localhost;Port=5432;Database=lingobridge;Username=REPLACE;Password=REPLACE
Engine__ApiKey=REPLACE_WITH_TRANSLATION_ENGINE_API_KEY
Auth__SigningKey=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_KEY
Auth__ClientUrl=https://lingobridge.eldervibe.dev

# --- Optional ---
ConnectionStrings__Redis=localhost:6379

# --- Set by the script for the service process ---
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production

# --- Docker containers the script expects while deploying: lingobridge-postgres, lingobridge-redis, lingobridge-mailpit ---

# --- Ingress (workflow "Deploy LingoBridge Ingress", manual inputs; defaults shown) ---
# domain=lingobridge.eldervibe.dev
# upstream_port=9999   # VPS port of the SSH reverse tunnel: ssh -N -R 9999:127.0.0.1:5080 eldervibe
# Script parameters of RunAsWindowService.ps1: -BackendPort 5080 -RemotePort 9999 -RemoteHost eldervibe -Domain lingobridge.eldervibe.dev
# Repository secrets used by the workflow: VPS_HOST, VPS_USER, VPS_SSH_KEY, VPS_KNOWN_HOSTS (optional VPS_PORT, default 22).
