# Values for the affine-sync sidecar. Copy to sync.env on the VPS (same folder as compose.sync.yml) and fill in.
# Do not commit the real file.

# Farm database (aurafarming) that the worker writes to. Published on the VPS host.
DATABASE_CONNECTION_STRING=Host=host.docker.internal;Port=4554;Database=aurafarming;Username=<user>;Password=<password>

# Read-only AFFiNE role (create with Farm.Sync/reader/provision-source-role.sql). `postgres` is the AFFiNE compose service.
AFFINE_DATABASE_URL=postgresql://affine_sync:<password>@postgres:5432/affine

AFFINE_WORKSPACE_ID=<workspace id>
AFFINE_COLLECTION_ID=<StaingDataSet collection id>
AFFINE_META_DOC_ID=<meta doc id>
AFFINE_FEEDS_DOC_ID=<feeds doc id>
AFFINE_FEEDS_BLOCK_ID=<feeds block id>
AFFINE_PORTFOLIO_COLLECTION_ID=<portfolio collection id>
AFFINE_GIGS_COLLECTION_ID=<gigs collection id>

SYNC_INTERVAL_SECONDS=60
