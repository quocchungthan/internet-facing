# Values for the affine-sync sidecar. Copy to sync.env on the VPS (same folder as compose.sync.yml) and fill in.
# Do not commit the real file.

# Farm database (aurafarming) the worker writes to: container eldervibe-farm-postgres on farm-network, port 4554.
# The password is generated by the Farm deploy: run `sudo cat /etc/farm/postgres.password` on the VPS.
DATABASE_CONNECTION_STRING=Host=eldervibe-farm-postgres;Port=4554;Database=aurafarming;Username=postgres;Password=<POSTGRES_PASSWORD>

# Read-only AFFiNE role (create with Farm.Sync/reader/provision-source-role.sql). `postgres` is the AFFiNE compose service.
AFFINE_DATABASE_URL=postgresql://affine_sync:<password>@postgres:5432/affine

# Use a workspace that only the owner belongs to: members of the workspace can publish pages to the public site.
# Production has its own workspace id; do not reuse the local one.
AFFINE_WORKSPACE_ID=<workspace id>
AFFINE_COLLECTION_ID=<StaingDataSet collection id>
AFFINE_META_DOC_ID=<meta doc id>
AFFINE_FEEDS_DOC_ID=<feeds doc id>
AFFINE_FEEDS_BLOCK_ID=<feeds block id>
AFFINE_PORTFOLIO_COLLECTION_ID=<portfolio collection id>
AFFINE_GIGS_COLLECTION_ID=<gigs collection id>

# Tools: no extra env values or Kind property needed when a page titled exactly Tools
# is an explicit member of AFFINE_COLLECTION_ID and contains a database titled Tools.
# For renamed/ambiguous pages or blocks, uncomment ID overrides (page stays in that collection):
# AFFINE_TOOLS_DOC_ID=<tools page id>
# AFFINE_TOOLS_BLOCK_ID=<tools database block id>

SYNC_INTERVAL_SECONDS=60

# The container reports unhealthy when no pass has succeeded for ~35 minutes (see `docker ps`).
# Failing passes back off exponentially up to 15 minutes; a bad page or document is skipped and logged, not fatal.
