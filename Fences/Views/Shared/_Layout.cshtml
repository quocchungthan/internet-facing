@inject Microsoft.Extensions.Options.IOptions<Fences.Models.IdentityAppOptions> IdentityOptions
@{
    var configuredBrandName = IdentityOptions.Value.BrandName;
    var brandName = string.IsNullOrWhiteSpace(configuredBrandName) ? "Shuneo" : configuredBrandName;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#059669" />
    <title>Identity | @brandName</title>

    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.svg" />
    <link rel="alternate icon" href="~/favicon.ico" type="image/x-icon" />

    <!-- Geist Font Variable & Webfont -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/core.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/mono.css" />

    <link rel="stylesheet" href="~/css/shared/tokens.css" data-system-theme="tokens" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/identity.css" data-system-theme="identity" />
</head>
<body class="system-identity">
    <a class="skip-link" href="#main-content">Skip to content</a>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <header class="topbar">
            <a class="brand" href="/" aria-label="Identity home">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 32 32"><use href="/icons.svg#brand-mark"></use></svg>
                </span>
                <span class="brand-title">
                    <span>@brandName</span>
                    <span class="brand-tag">Identity</span>
                </span>
            </a>
            <nav class="actions">
                <span class="user">
                    <span class="user-dot" aria-hidden="true"></span>
                    <span>@User.Identity.Name</span>
                </span>
                <a class="btn ghost btn-sm" href="/auth/logout">
                    <span>Logout</span>
                    <svg style="width: 14px; height: 14px;" viewBox="0 0 24 24" aria-hidden="true"><use href="/icons.svg#logout-icon"></use></svg>
                </a>
            </nav>
        </header>
    }
    <main id="main-content">@RenderBody()</main>
</body>
</html>
