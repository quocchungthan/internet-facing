@model IReadOnlyList<IdentityNavigationApp>
@inject Microsoft.Extensions.Options.IOptions<Fences.Models.IdentityAppOptions> IdentityOptions
@{
    var returnUrl = ViewData["ReturnUrl"]?.ToString();
    var configuredBrandName = IdentityOptions.Value.BrandName;
    var brandName = string.IsNullOrWhiteSpace(configuredBrandName) ? "Shuneo" : configuredBrandName;
}
@if (User.Identity?.IsAuthenticated == true)
{
    <section class="dashboard">
        <header class="dashboard-head">
            <p class="eyebrow">Workspace Hub</p>
            <h1>Your workspace</h1>
            <p>Signed in as <strong>@User.Identity?.Name</strong>. Select a service below to continue.</p>
        </header>
        <div class="apps">
            @foreach (var app in Model)
            {
                var iconId = app.Key?.ToLowerInvariant() switch
                {
                    "storage" => "storage-icon",
                    "note" => "note-icon",
                    "mail" => "mail-icon",
                    _ => "brand-mark"
                };
                <article class="card" data-app-key="@app.Key">
                    <div class="card__header">
                        <div class="card__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><use href="/icons.svg#@iconId"></use></svg>
                        </div>
                        <span class="card__label">@app.Key</span>
                    </div>
                    <h2>@app.Name</h2>
                    <p>@app.Description</p>
                    <a class="btn ghost" href="@app.Url" aria-label="Open @app.Name">
                        <span>Open service</span>
                        <span class="btn-arrow" aria-hidden="true">
                            <svg style="width: 14px; height: 14px;" viewBox="0 0 20 20"><use href="/icons.svg#arrow-right"></use></svg>
                        </span>
                    </a>
                </article>
            }
        </div>
    </section>
}
else
{
    <section class="login-screen">
        <article class="login-panel" aria-live="polite">
            <div class="login-panel__mark" aria-hidden="true">
                <svg viewBox="0 0 32 32"><use href="/icons.svg#brand-mark"></use></svg>
            </div>
            <p class="eyebrow">One account · Every service</p>
            <h1>Welcome to @brandName</h1>
            <p>Sign in with your GitHub account to access Storage, Note, Mail, and your shared tools.</p>
            
            <a class="btn btn-github pixel-login" href="@(string.IsNullOrWhiteSpace(returnUrl) ? "/auth/login" : $"/auth/login?returnUrl={Uri.EscapeDataString(returnUrl)}")">
                <svg style="width: 20px; height: 20px;" viewBox="0 0 24 24" aria-hidden="true"><use href="/icons.svg#github-icon"></use></svg>
                <span>Continue with GitHub</span>
                <span class="btn-arrow" aria-hidden="true">
                    <svg style="width: 16px; height: 16px;" viewBox="0 0 20 20"><use href="/icons.svg#arrow-right"></use></svg>
                </span>
            </a>

            <div class="login-panel__note">
                <svg viewBox="0 0 24 24" aria-hidden="true"><use href="/icons.svg#verified-shield"></use></svg>
                <span>SSO authenticated session for @brandName</span>
            </div>
        </article>
    </section>
}
