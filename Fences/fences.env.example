# Bootstrap inputs are configured as separate values in the GitHub hostkey-server environment.
# The bootstrap provisioner generates certificate paths/passwords and persistent-storage paths.
ASPNETCORE_ENVIRONMENT=Production
Authentication__GitHub__ClientId=REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID
Authentication__GitHub__ClientSecret=REPLACE_WITH_GITHUB_OAUTH_CLIENT_SECRET
IdentityApp__BrandName=Shuneo
IdentityApp__CookieDomain=.eldervibe.dev
IdentityApp__OidcIssuer=https://identity.eldervibe.dev
IdentityApp__PersistentLoginDays=30
# Return hosts are host names only; CORS entries and redirects are complete HTTPS origins/URLs.
# Index 0 overrides the first appsettings.json entry; the remaining eldervibe.dev hosts come from appsettings.json.
IdentityApp__AllowedReturnHosts__0=identity.eldervibe.dev
IdentityApp__AllowedCorsOrigins__0=https://identity.eldervibe.dev
# IdentityApp__OidcClients is an indexed array; client id = subdomain label (mail, storage, note).
IdentityApp__OidcClients__0__ClientId=REPLACE_WITH_OIDC_CLIENT_ID
IdentityApp__OidcClients__0__DisplayName=REPLACE_WITH_OIDC_CLIENT_NAME
# Leave empty/unset for a public client (PKCE always required); set to register a confidential client (PKCE optional).
IdentityApp__OidcClients__0__ClientSecret=REPLACE_WITH_OIDC_CLIENT_SECRET
# Optional: force PKCE for a confidential client (used for note/AFFiNE). Missing means false.
# IdentityApp__OidcClients__0__RequirePkce=true
IdentityApp__OidcClients__0__RedirectUris__0=https://application.example.invalid/oauth/callback
IdentityApp__OidcClients__0__PostLogoutRedirectUris__0=https://application.example.invalid/
# Second client example (repeat the pattern with an incrementing index for each additional client):
# IdentityApp__OidcClients__1__ClientId=REPLACE_WITH_SECOND_OIDC_CLIENT_ID
# IdentityApp__OidcClients__1__RedirectUris__0=https://second-application.example.invalid/oauth/callback