# FENCES_BOOTSTRAP_DOTENV payload. Store this complete template with operator values as a GitHub production environment secret.
# The bootstrap provisioner generates certificate paths/passwords and persistent-storage paths; do not include those script-managed values here.
ASPNETCORE_ENVIRONMENT=Production
Authentication__GitHub__ClientId=REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID
Authentication__GitHub__ClientSecret=REPLACE_WITH_GITHUB_OAUTH_CLIENT_SECRET
IdentityApp__BrandName=Shuneo
IdentityApp__CookieDomain=.shuneo.com
IdentityApp__OidcIssuer=https://identity.example.invalid
IdentityApp__PersistentLoginDays=30
# Return hosts are host names only; CORS entries and redirects are complete HTTPS origins/URLs.
IdentityApp__AllowedReturnHosts__0=identity.example.invalid
IdentityApp__AllowedCorsOrigins__0=https://identity.example.invalid
IdentityApp__OidcClients__0__ClientId=REPLACE_WITH_OIDC_CLIENT_ID
IdentityApp__OidcClients__0__DisplayName=REPLACE_WITH_OIDC_CLIENT_NAME
IdentityApp__OidcClients__0__RedirectUris__0=https://application.example.invalid/oauth/callback
IdentityApp__OidcClients__0__PostLogoutRedirectUris__0=https://application.example.invalid/