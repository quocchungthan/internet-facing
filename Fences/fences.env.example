# Bootstrap inputs are configured as separate values in the GitHub hostkey-server environment.
# The bootstrap provisioner generates certificate paths/passwords and persistent-storage paths.
ASPNETCORE_ENVIRONMENT=Production
# GitHub OAuth app (github.com > Settings > Developer settings > OAuth Apps).
# Authorization callback URL must be EXACTLY https://identity.eldervibe.dev/signin-github: Fences does not
# configure it, ASP.NET builds the redirect_uri from the request (https + host + /signin-github, honoring the
# X-Forwarded-* headers from Caddy), so a different host or http makes GitHub reject the login.
# Homepage URL: https://identity.eldervibe.dev
Authentication__GitHub__ClientId=REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID
Authentication__GitHub__ClientSecret=REPLACE_WITH_GITHUB_OAUTH_CLIENT_SECRET
IdentityApp__BrandName=Shuneo
IdentityApp__CookieDomain=.eldervibe.dev
IdentityApp__OidcIssuer=https://identity.eldervibe.dev
IdentityApp__PersistentLoginDays=30
# Return hosts are host names only; CORS entries and redirects are complete HTTPS origins/URLs.
# Index 0 overrides the first appsettings.json entry; the remaining eldervibe.dev hosts come from appsettings.json.
# eldervibe.dev (the main site and Farm.Mind) is NOT in appsettings.json yet: list it here, or sign-in returns
# from the site are rejected. In production the workflows write these from the variables
# FENCES_ALLOWED_RETURN_HOST and FENCES_ALLOWED_CORS_ORIGIN.
IdentityApp__AllowedReturnHosts__0=identity.eldervibe.dev
IdentityApp__AllowedReturnHosts__1=eldervibe.dev
IdentityApp__AllowedCorsOrigins__0=https://identity.eldervibe.dev
IdentityApp__AllowedCorsOrigins__1=https://eldervibe.dev

# OIDC clients. In production they come from the secret FENCES_OIDC_CLIENTS_JSON (a JSON array); the indexed
# form below is the same data for a manual or local run. Client id = subdomain label, except the site and MCP.
# Leave ClientSecret out for a public client (PKCE always required); set it for a confidential client.

# 0: the main site (Farm UI), public client
IdentityApp__OidcClients__0__ClientId=farm
IdentityApp__OidcClients__0__DisplayName=Farm
IdentityApp__OidcClients__0__RedirectUris__0=https://eldervibe.dev/signin-oidc
IdentityApp__OidcClients__0__PostLogoutRedirectUris__0=https://eldervibe.dev/

# 1: note (AFFiNE), confidential, PKCE forced
IdentityApp__OidcClients__1__ClientId=note
IdentityApp__OidcClients__1__DisplayName=Note
IdentityApp__OidcClients__1__ClientSecret=REPLACE_WITH_NOTE_CLIENT_SECRET
IdentityApp__OidcClients__1__RequirePkce=true
IdentityApp__OidcClients__1__RedirectUris__0=https://note.eldervibe.dev/oauth/callback
IdentityApp__OidcClients__1__PostLogoutRedirectUris__0=https://note.eldervibe.dev/

# 2: MCP / AI clients, public. Desktop harnesses use loopback redirects (adjust the port to the client).
IdentityApp__OidcClients__2__ClientId=mcp
IdentityApp__OidcClients__2__DisplayName=MCP client
IdentityApp__OidcClients__2__RedirectUris__0=http://localhost:33418/callback
IdentityApp__OidcClients__2__RedirectUris__1=http://127.0.0.1:33418/callback

# Add storage (seafile) and mail the same way, with the redirect URLs their own examples use:
# IdentityApp__OidcClients__3__ClientId=seafile
# IdentityApp__OidcClients__3__ClientSecret=REPLACE_WITH_SEAFILE_CLIENT_SECRET
# IdentityApp__OidcClients__3__RedirectUris__0=https://storage.eldervibe.dev/oauth/callback/
# IdentityApp__OidcClients__4__ClientId=mail
# IdentityApp__OidcClients__4__RedirectUris__0=https://mail.eldervibe.dev/auth/github/callback

# FENCES_OIDC_CLIENTS_JSON equivalent of the clients above (secret value, one line):
# [{"ClientId":"farm","DisplayName":"Farm","RedirectUris":["https://eldervibe.dev/signin-oidc"],"PostLogoutRedirectUris":["https://eldervibe.dev/"]},
#  {"ClientId":"note","DisplayName":"Note","ClientSecret":"...","RequirePkce":true,"RedirectUris":["https://note.eldervibe.dev/oauth/callback"],"PostLogoutRedirectUris":["https://note.eldervibe.dev/"]},
#  {"ClientId":"mcp","DisplayName":"MCP client","RedirectUris":["http://localhost:33418/callback","http://127.0.0.1:33418/callback"]}]
