# Variables read by Fences/compose.dev.yml. Export them in the shell (or an env file passed with --env-file).
# Never commit real values.

# Required: secret of the local `note` (AFFiNE) confidential client.
FENCES_NOTE_CLIENT_SECRET=REPLACE_WITH_ANY_LOCAL_SECRET

# GitHub OAuth app for sign-in. Without these the login page returns 500.
# Create a separate dev OAuth app. Homepage URL: http://fences.localhost:5188
# Authorization callback URL must be EXACTLY http://fences.localhost:5188/signin-github
# (the redirect_uri is built from the request, so always browse Fences as fences.localhost:5188, not
# localhost:5188; with another FENCES_HOST_PORT the registered callback must use that port).
FENCES_GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID
FENCES_GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_OAUTH_CLIENT_SECRET

# Optional port overrides (defaults shown); keep them in line with main's deployment/local/compose.yml.
# FENCES_HOST_PORT=5188
# FARM_HOST_PORT=8080
# MIND_HOST_PORT=8081
# AFFINE_HOST_PORT=3010
# MCP_CALLBACK_PORT=33418
