# Variables read by deployment/local/compose.yml. Copy to deployment/local/.env (gitignored) and fill in,
# then, from deployment/local:  docker compose up -d --build
# Never commit real values.

# Required: password of the local Farm database (aurafarming). Any value; it is set on first creation of the volume.
POSTGRES_PASSWORD=REPLACE_WITH_ANY_LOCAL_PASSWORD

# Optional (defaults shown)
# POSTGRES_USER=postgres
# POSTGRES_HOST_PORT=4554
# FARM_HOST_PORT=8080
# MIND_HOST_PORT=8081

# Sign-in through the local Fences (sub/identity, Fences/compose.dev.yml). The defaults already match its
# `farm-local` client; change them only to point at another identity service.
# FARM_AUTH_AUTHORITY=http://fences.localhost:5188
# FARM_AUTH_CLIENT_ID=farm-local
