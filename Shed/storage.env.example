# Compose environment for the Seafile storage stack (storage.eldervibe.dev).
# On the VPS this is written to $STORAGE_DEPLOY_DIR/.env (mode 600) by the "Deploy Storage" workflow from
# GitHub variables and secrets of the hostkey-server environment. Copy to .env only for a manual or local run.
# Never commit a real .env.

# --- Secrets (GitHub secrets: STORAGE_MYSQL_ROOT_PASSWORD, STORAGE_SEAFILE_ADMIN_PASSWORD, STORAGE_OAUTH_CLIENT_SECRET) ---
MYSQL_ROOT_PASSWORD=REPLACE_WITH_MYSQL_ROOT_PASSWORD
SEAFILE_ADMIN_PASSWORD=REPLACE_WITH_SEAFILE_ADMIN_PASSWORD
OAUTH_CLIENT_SECRET=REPLACE_WITH_FENCES_OIDC_CLIENT_SECRET

# --- Variables (GitHub variables; the values shown are the workflow defaults) ---
# Absolute path on the host holding Seafile data (variable STORAGE_DEPLOY_DIR, required, not '/').
STORAGE_BASE_DIR=/srv/storage
SERVICE_DOMAIN=storage.eldervibe.dev
SERVICE_UPSTREAM_PORT=8080
TIME_ZONE=Asia/Ho_Chi_Minh
SEAFILE_ADMIN_EMAIL=admin@eldervibe.dev

# --- Sign-in through Fences (must match an entry of IdentityApp__OidcClients in Fences) ---
OAUTH_CLIENT_ID=seafile
OAUTH_REDIRECT_URL=https://storage.eldervibe.dev/oauth/callback/
OAUTH_AUTHORIZATION_URL=https://identity.eldervibe.dev/connect/authorize
OAUTH_TOKEN_URL=https://identity.eldervibe.dev/connect/token
OAUTH_USER_INFO_URL=https://identity.eldervibe.dev/connect/userinfo
