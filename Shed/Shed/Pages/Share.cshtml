@page
@model ShareModel

@{
    ViewData["Title"] = "Share Links";
}

<style>
    .p-share-link {
        padding: 2rem 0;
    }
    
    .p-share__heading {
        font-size: 1.75rem;
        font-weight: 400;
        margin-bottom: 2rem;
        color: #111;
    }
    
    .p-share__form {
        margin-bottom: 2rem;
        background: #f7f5f3;
        padding: 1.5rem;
        border-radius: 4px;
    }
    
    .p-share__form-group {
        margin-bottom: 1rem;
    }
    
    .p-share__form-group label {
        display: block;
        font-size: 0.938rem;
        font-weight: 500;
        margin-bottom: 0.5rem;
        color: #111;
    }
    
    .p-share__form-group input,
    .p-share__form-group select {
        width: 100%;
        padding: 0.5rem;
        border: 1px solid #cdcdcd;
        border-radius: 2px;
        font-size: 0.938rem;
    }
    
    .p-share__form-group input:focus,
    .p-share__form-group select:focus {
        outline: none;
        border-color: #111;
        box-shadow: inset 0 0 0 2px rgba(0, 0, 0, 0.05);
    }
    
    .p-share__actions {
        display: flex;
        gap: 1rem;
    }
    
    .p-share__message {
        margin: 1rem 0;
        padding: 1rem;
        border-radius: 2px;
        display: none;
    }
    
    .p-share__message--success {
        background: #e5f5e6;
        border-left: 4px solid #0e8420;
        color: #0e8420;
    }
    
    .p-share__message--error {
        background: #fdf2f1;
        border-left: 4px solid #da291c;
        color: #da291c;
    }
    
    .p-share__table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
    }
    
    .p-share__table thead {
        background: #f7f5f3;
        border-bottom: 1px solid #cdcdcd;
    }
    
    .p-share__table th {
        padding: 1rem;
        text-align: left;
        font-weight: 500;
        font-size: 0.938rem;
    }
    
    .p-share__table td {
        padding: 1rem;
        border-bottom: 1px solid #e8e8e8;
        font-size: 0.875rem;
    }
    
    .p-share__table tr:hover {
        background: #f7f5f3;
    }
    
    .p-share__status {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 2px;
        font-size: 0.75rem;
        font-weight: 500;
    }
    
    .p-share__status--active {
        background: #e5f5e6;
        color: #0e8420;
    }
    
    .p-share__status--expired {
        background: #fdf2f1;
        color: #da291c;
    }
    
    .p-share__link-input {
        width: 100%;
        padding: 0.5rem;
        border: 1px solid #cdcdcd;
        border-radius: 2px;
        font-family: monospace;
        font-size: 0.875rem;
        background: white;
    }
    
    .p-share__button {
        padding: 0.5rem 1rem;
        border: 1px solid #111;
        background: white;
        color: #111;
        border-radius: 2px;
        cursor: pointer;
        font-size: 0.938rem;
        font-weight: 500;
        transition: all 0.2s;
    }
    
    .p-share__button:hover {
        background: #111;
        color: white;
    }
    
    .p-share__button--primary {
        background: #111;
        color: white;
    }
    
    .p-share__button--primary:hover {
        background: #333;
    }
    
    .p-share__button--small {
        padding: 0.25rem 0.75rem;
        font-size: 0.8rem;
    }
    
    .p-share__empty-state {
        text-align: center;
        padding: 2rem;
        color: #666;
    }
</style>

<div class="p-share-link">
    <h1 class="p-share__heading">Manage Share Links</h1>

    @if (!string.IsNullOrEmpty(TempData["SuccessMessage"] as string))
    {
        <div class="p-share__message p-share__message--success" id="successMessage">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!string.IsNullOrEmpty(TempData["ErrorMessage"] as string))
    {
        <div class="p-share__message p-share__message--error" id="errorMessage">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!ModelState.IsValid)
    {
        @foreach (var error in ModelState.Values.SelectMany(x => x.Errors))
        {
            <div class="p-share__message p-share__message--error">
                @error.ErrorMessage
            </div>
        }
    }

    <form method="post" class="p-share__form">
        <div class="p-share__form-group">
            <label for="TargetPath">File or Folder Path</label>
            <input type="text" id="TargetPath" name="TargetPath" asp-for="TargetPath" required placeholder="/path/to/file-or-folder" />
        </div>

        <div class="p-share__form-group">
            <label for="ExpirationMinutes">Expires In</label>
            <select id="ExpirationMinutes" name="ExpirationMinutes" asp-for="ExpirationMinutes">
                <option value="60">1 hour</option>
                <option value="1440" selected>24 hours</option>
                <option value="10080">7 days</option>
                <option value="43200">30 days</option>
            </select>
        </div>

        <div class="p-share__actions">
            <button type="submit" class="p-share__button p-share__button--primary" asp-page-handler="Create">
                Create Share Link
            </button>
            <button type="button" class="p-share__button" id="cleanupBtn">
                Clean Up Expired Links
            </button>
        </div>
    </form>

    <h2 style="font-size: 1.25rem; margin-top: 2rem; margin-bottom: 1rem;">Your Share Links</h2>

    @if (Model.ShareLinks?.Count > 0)
    {
        <table class="p-share__table">
            <thead>
                <tr>
                    <th>Path</th>
                    <th>Created</th>
                    <th>Expires</th>
                    <th>Status</th>
                    <th>Link</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var link in Model.ShareLinks)
                {
                    var isExpired = link.IsExpired;
                    var linkUrl = $"/api/download/file?key={Uri.EscapeDataString(link.AccessKey)}&path={Uri.EscapeDataString(link.TargetPath)}";
                    
                    <tr>
                        <td><code style="background: #f7f5f3; padding: 0.25rem 0.5rem; border-radius: 2px;">@link.TargetPath</code></td>
                        <td>@link.CreatedAt:g</td>
                        <td>@(link.ExpiresAt?.ToString("g") ?? "N/A")</td>
                        <td>
                            <span class="p-share__status @(isExpired ? "p-share__status--expired" : "p-share__status--active")">
                                @(isExpired ? "Expired" : "Active")
                            </span>
                        </td>
                        <td>
                            <input type="text" class="p-share__link-input" value="@linkUrl" readonly />
                        </td>
                        <td>
                            <button type="button" class="p-share__button p-share__button--small" onclick="copyToClipboard(this)">
                                Copy
                            </button>
                            <button type="button" class="p-share__button p-share__button--small" onclick="revokeLink('@link.AccessKey')" style="margin-left: 0.5rem;">
                                Revoke
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="p-share__empty-state">
            <p>No active share links</p>
        </div>
    }
</div>

<script>
    function copyToClipboard(button) {
        const input = button.parentElement.parentElement.querySelector('.p-share__link-input');
        if (!input) return;
        
        input.select();
        document.execCommand('copy');
        
        const originalText = button.textContent;
        button.textContent = 'Copied!';
        setTimeout(() => {
            button.textContent = originalText;
        }, 1500);
    }

    function revokeLink(accessKey) {
        if (!confirm('Are you sure you want to revoke this link?')) {
            return;
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        
        fetch('/share?handler=Revoke', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': token
            },
            body: JSON.stringify({ accessKey: accessKey })
        })
        .then(response => {
            if (response.ok) {
                window.location.reload();
            } else {
                alert('Failed to revoke link');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error revoking link');
        });
    }

    document.getElementById('cleanupBtn')?.addEventListener('click', async () => {
        if (!confirm('Delete all expired links?')) {
            return;
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        
        try {
            const response = await fetch('/share?handler=Cleanup', {
                method: 'POST',
                headers: {
                    'X-CSRF-TOKEN': token
                }
            });

            if (response.ok) {
                window.location.reload();
            } else {
                alert('Failed to clean up links');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Error cleaning up links');
        }
    });

    // Auto-hide success/error messages after 5 seconds
    const successMsg = document.getElementById('successMessage');
    if (successMsg) {
        setTimeout(() => {
            successMsg.style.display = 'none';
        }, 5000);
    }

    const errorMsg = document.getElementById('errorMessage');
    if (errorMsg) {
        setTimeout(() => {
            errorMsg.style.display = 'none';
        }, 5000);
    }
</script>
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">
            <h5>Create Share Link</h5>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="Create">
                <div class="mb-3">
                    <label for="TargetPath" class="form-label">Target Path</label>
                    <input type="text" class="form-control" id="TargetPath" 
                           asp-for="TargetPath" placeholder="/path/to/file-or-folder" required>
                    <small class="text-muted">Full path to the file or folder you want to share</small>
                </div>

                <div class="mb-3">
                    <label for="ExpirationMinutes" class="form-label">Expires In (minutes)</label>
                    <input type="number" class="form-control" id="ExpirationMinutes" 
                           asp-for="ExpirationMinutes" value="1440" min="1" required>
                    <small class="text-muted">Default: 1440 minutes (24 hours)</small>
                </div>

                <button type="submit" class="btn btn-primary">Create Share Link</button>
                <button type="button" class="btn btn-secondary" onclick="cleanupExpired()">Clean Up Expired Links</button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5>Active Share Links</h5>
        </div>
        <div class="card-body">
            @if (Model.ShareLinks.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Path</th>
                                <th>Created</th>
                                <th>Expires</th>
                                <th>Status</th>
                                <th>Link</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var link in Model.ShareLinks)
                            {
                                var isExpired = link.IsExpired;
                                var statusClass = isExpired ? "text-danger" : "text-success";
                                var statusText = isExpired ? "Expired" : "Active";
                                var shareUrl = $"/api/download/file?key={link.AccessKey}&path={Uri.EscapeDataString(link.TargetPath)}";

                                <tr class="@(isExpired ? "table-secondary" : "")">
                                    <td><code>@link.TargetPath</code></td>
                                    <td>@link.CreatedAt.ToString("g")</td>
                                    <td>@link.ExpiresAt?.ToString("g")</td>
                                    <td><span class="@statusClass">@statusText</span></td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" 
                                               id="link-@link.AccessKey" 
                                               value="@shareUrl" readonly>
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-primary" 
                                                onclick="copyToClipboard('link-@link.AccessKey')">
                                            Copy
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" 
                                                onclick="revokeLink('@link.AccessKey')">
                                            Revoke
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No active share links</p>
            }
        </div>
    </div>
</div>

<script>
function copyToClipboard(elementId) {
    const element = document.getElementById(elementId);
    element.select();
    document.execCommand('copy');
    
    const btn = event.target;
    const originalText = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(() => {
        btn.textContent = originalText;
    }, 2000);
}

function revokeLink(accessKey) {
    if (confirm('Are you sure you want to revoke this share link?')) {
        fetch('/share?handler=Revoke', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify({ accessKey: accessKey })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Failed to revoke link: ' + (data.error || 'Unknown error'));
            }
        })
        .catch(e => alert('Error: ' + e.message));
    }
}

function cleanupExpired() {
    if (confirm('Delete all expired share links?')) {
        fetch('/share?handler=Cleanup', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            }
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Failed to clean up: ' + (data.error || 'Unknown error'));
            }
        })
        .catch(e => alert('Error: ' + e.message));
    }
}
</script>

