<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#173d2c" />
    <title>@ViewData["Title"] - Shuneo Storage</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@300;400;500;700&display=swap" />
    <link rel="stylesheet" href="https://unpkg.com/vanilla-framework@4.24.0/vanilla-framework-version-4.24.0.min.css" />
    <link rel="stylesheet" href="~/css/shared/tokens.css" asp-append-version="true" data-system-theme="tokens" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Shed.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/storage.css" asp-append-version="true" data-system-theme="storage" />
</head>
<body class="system-storage">
    @using Microsoft.AspNetCore.Identity
    @inject SignInManager<IdentityUser> SignInManager
    @inject IConfiguration Configuration
    @{ 
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
        var bridgeEnabled = bool.TryParse(Configuration["IdentityBridge:Enabled"], out var bridgeMode) && bridgeMode;
        var identityBase = (Configuration["IdentityBridge:BaseUrl"] ?? string.Empty).Trim().TrimEnd('/');
        var callbackUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/";
        var externalLoginUrl = string.IsNullOrWhiteSpace(identityBase)
            ? "/signin"
            : $"{identityBase}/?returnUrl={System.Text.Encodings.Web.UrlEncoder.Default.Encode(callbackUrl)}";
        var isAuthenticated = User?.Identity?.IsAuthenticated == true || SignInManager.IsSignedIn(User!);
    }

    <div class="page-frame">
        @if (isAuthenticated)
        {
            <div class="app-shell">
                <aside class="side-nav" id="sideNav">
                    <a class="side-nav__brand" asp-page="/Index" aria-label="Storage home">
                        <span class="side-nav__brand-mark" aria-hidden="true">ST</span>
                        <span class="nav-text">Storage</span>
                    </a>
                    <div class="side-nav__top">
                        <button type="button" class="side-nav__toggle" id="sideNavToggle" aria-expanded="true" aria-controls="sideNav" title="Collapse or expand menu">☰</button>
                        <span class="side-nav__user" title="@User.Identity?.Name">@User.Identity?.Name</span>
                    </div>

                    <nav class="side-nav__menu" aria-label="Main navigation">
                        <a asp-page="/Files" class="nav-link @(currentPage.Equals("/Files", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)">
                            <span class="nav-icon" aria-hidden="true">▤</span>
                            <span class="nav-text">Files</span>
                        </a>
                        <a asp-page="/UserSettings" class="nav-link @(currentPage.Equals("/UserSettings", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)">
                            <span class="nav-icon" aria-hidden="true">⚙</span>
                            <span class="nav-text">Settings</span>
                        </a>
                        <a asp-page="/Api" class="nav-link @(currentPage.Equals("/Api", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)">
                            <span class="nav-icon" aria-hidden="true">⌘</span>
                            <span class="nav-text">API Keys</span>
                        </a>
                    </nav>
                </aside>

                <div class="workspace-pane">
                    <header class="utility-topbar">
                        <div class="utility-topbar__left">
                            <button type="button" class="side-nav__toggle mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle navigation">☰</button>
                            @await RenderSectionAsync("TopbarLeft", required: false)
                        </div>
                        <div class="utility-topbar__right">
                            <span class="utility-topbar__user">@User.Identity?.Name</span>
                            <form method="get" action="/auth/logout">
                                <input type="hidden" name="returnUrl" value="/" />
                                <button type="submit" class="icon-logout" aria-label="Logout" title="Logout">⎋</button>
                            </form>
                        </div>
                    </header>

                    <main role="main" class="main-content">
                        @RenderBody()
                    </main>
                </div>
            </div>
        }
        else
        {
            var authPage = ViewContext.HttpContext.Request.Path.Value?.ToLowerInvariant() ?? "";
            <main class="login-shell" role="main" style="--login-background-image:url('/public/login-background');">
                <section class="auth-card">
                    <div class="auth-card__brand">
                        <span class="auth-card__logo" aria-hidden="true">▤</span>
                        <span class="auth-card__title">Shuneo Storage</span>
                    </div>

                          <nav class="auth-tabs" aria-label="Authentication options">
                                @if (bridgeEnabled)
                                {
                                     <a href="@externalLoginUrl" class="auth-tab auth-tab--active">Sign in with GitHub</a>
                                }
                                else
                                {
                                     <a href="/Identity/Account/Login"
                                         class="auth-tab @(authPage.Contains("login") ? "auth-tab--active" : "")">Sign in</a>
                                     <a href="/Identity/Account/Register"
                                         class="auth-tab @(authPage.Contains("register") ? "auth-tab--active" : "")">Register</a>
                                     <a href="/Identity/Account/ForgotPassword"
                                         class="auth-tab @(authPage.Contains("forgot") ? "auth-tab--active" : "")">Reset</a>
                                }
                          </nav>

                    <div class="login-form-host">
                        @RenderBody()
                    </div>
                </section>
            </main>
        }
    </div>

    <footer class="footer footer--thin">
        <div class="status-row">
            <span>Status: Online</span>
            <span>Mode: Secure Session</span>
        </div>
    </footer>

    <div id="eldervibe-service-launcher" data-current-app-id="storage-app" data-identity-base-url="https://identity.eldervibe.dev"></div>

    @{
        var isLocalLauncherHost = Context.Request.Host.Host.Equals("localhost", StringComparison.OrdinalIgnoreCase)
            || Context.Request.Host.Host.Equals("127.0.0.1", StringComparison.OrdinalIgnoreCase);
        var sharedLauncherBaseUrl = (isLocalLauncherHost
            ? "http://localhost:5055"
            : Configuration["SharedLauncherBaseUrl"] ?? "https://eldervibe.dev").TrimEnd('/');
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="@($"{sharedLauncherBaseUrl}/js/service-launcher.js")"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

