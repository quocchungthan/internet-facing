@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="page-header">
    <div>
        <h1>Welcome</h1>
        <p>Use the side navigation to manage files, API access keys, and user preferences.</p>
    </div>
</section>

<section class="panel">
    <h2>Quick Start</h2>
    <ol>
        <li>Open the Files page to review grid cards and permission levels.</li>
        <li>Generate or revoke keys from the API page.</li>
        <li>Store hidden profile settings from User Settings.</li>
    </ol>
</section>

