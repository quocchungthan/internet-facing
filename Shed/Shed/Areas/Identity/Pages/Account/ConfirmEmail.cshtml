@page
@model Shed.Areas.Identity.Pages.Account.ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm Email";
}

<h2>@Model.StatusMessage</h2>

@if (!Model.Succeeded)
{
    <p>There was an issue confirming your email. Please contact support.</p>
}
else
{
    <p>
        <a asp-page="/SignIn" asp-route-emailConfirmed="1">Continue to sign in</a>
    </p>
}

