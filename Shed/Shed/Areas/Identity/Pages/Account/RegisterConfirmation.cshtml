@page
@model Shed.Areas.Identity.Pages.Account.RegisterConfirmationModel
@{
    ViewData["Title"] = "Register confirmation";
}

<h2>Check your email</h2>
<p>
    We've sent a confirmation link to <strong>@Model.Email</strong>. Please check your inbox and follow the instructions to confirm your account.
</p>
<p>
    Already confirmed? <a asp-page="/SignIn">Sign in</a>
</p>

