@page
@model Shed.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div asp-validation-summary="ModelOnly" class="auth-validation-error" role="alert"></div>

<form method="post">
    @Html.AntiForgeryToken()
    <div class="auth-field">
        <label asp-for="Input.Email">Email</label>
        <input asp-for="Input.Email" class="auth-input" placeholder="name@example.com" />
        <span asp-validation-for="Input.Email" class="auth-field-error"></span>
    </div>
    <button type="submit" class="auth-submit">Send reset link</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

