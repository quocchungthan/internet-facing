# Compose environment for MailBox (maddy + webmail). Normally generated, not hand-written:
#   python scripts/manage.py init --domain eldervibe.dev            (add --local for a laptop test stack)
# init refuses to overwrite an existing .env and creates SECRET_KEY plus mailbox credentials under secrets/.
# Copy to .env only to see the full list of settings. Never commit a real .env.

# --- Written by `manage.py init` ---
MAIL_DOMAIN=eldervibe.dev
# Space-separated list of every domain served; defaults to MAIL_DOMAIN.
MAIL_DOMAINS=eldervibe.dev
MAIL_HOSTNAME=mail.eldervibe.dev
# 64 hex characters, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
SECRET_KEY=REPLACE_WITH_64_HEX_CHARS

# --- Sign-in through Fences (client id is the subdomain label) ---
OAUTH_ISSUER=https://identity.eldervibe.dev
OAUTH_CLIENT_ID=mail
# Leave empty for a public client (PKCE); set for a confidential client.
OAUTH_CLIENT_SECRET=
# Default is https://<MAIL_HOSTNAME>/auth/github/callback when empty.
OAUTH_REDIRECT_URL=

# --- Optional overrides (defaults shown) ---
BIND_IP=0.0.0.0
SMTP_PORT=25
SUBMISSION_PORT=587
IMAP_PORT=993
WEB_PORT=8000
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# --- Written only by `manage.py init --local` (laptop test stack) ---
# BIND_IP=127.0.0.1
# SMTP_PORT=2525
# SUBMISSION_PORT=1587
# IMAP_PORT=1993
# HTTP_PORT=8080
# HTTPS_PORT=8443
# SSL_CERT_FILE=/extra-ca/test-ca.pem
# LOCAL_TEST=1
