    "@types/jquery": "4.0.1",
    "@types/node": "26.6.2",
    "@types/ws": "8.18.1",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
