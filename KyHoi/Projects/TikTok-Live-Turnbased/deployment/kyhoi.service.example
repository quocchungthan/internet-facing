[Unit]
Description=Ky Hoi IP-based room game engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kyhoi
WorkingDirectory=/opt/internet-facing/KyHoi/Projects/TikTok-Live-Turnbased/app
EnvironmentFile=/opt/internet-facing/KyHoi/Projects/TikTok-Live-Turnbased/.env
ExecStart=/usr/bin/node --import tsx src/server.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target

